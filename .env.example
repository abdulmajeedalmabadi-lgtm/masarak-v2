NODE_ENV=development
PORT=4000
# PostgreSQL is the default. Explicitly use file-demo only for local demonstrations.
STORAGE_MODE=postgres
DATABASE_URL=postgresql://masarak:CHANGE_ME@127.0.0.1:5432/masarak?schema=public
JWT_SECRET=
DEMO_PASSWORD=
PUBLIC_APP_URL=http://localhost:5173
# For phone scanning, set the reachable HTTPS frontend URL before printing QR signs.
# localhost on a phone refers to that phone, not this development computer.
CORS_ORIGINS=http://localhost:5173
# Optional separate backend deployment; leave empty for same-origin/proxied hosting.
VITE_API_URL=
# Optional background Web Push; generate locally with npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional reference-sign export only (not required by the application).
PRINT_APP_URL=

# Optional local Vite proxy target; defaults to existing API on port 4000.
# API_PROXY_TARGET=http://127.0.0.1:4000
